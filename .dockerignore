# Keep the build context small (context is the repo root for every service image).
.git
.github
.venv
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo
.mypy_cache
.ruff_cache
.pytest_cache
htmlcov
.coverage
infra/.data
# Match at any depth: the frontend's node_modules/dist live under apps/curation-ui/ and must not
# leak into the build context (host pnpm symlinks break inside the image).
**/node_modules
**/dist
docs
**/tests
scratchpad
