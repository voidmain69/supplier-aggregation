{
  "openapi": "3.1.0",
  "info": {
    "title": "search",
    "description": "Search service. Find products by free-text query (name/brand/code/articul), by meaning (natural-language semantic search), or by exact identifier (code, articul, GTIN). Indexed from supplier product events.",
    "contact": {
      "name": "Supplier Aggregation Platform",
      "email": "Info_DIT@erc.ua"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Lexical product search",
        "description": "Search products by free text over name, brand, articul and codes. The query is tokenized and every token must match (AND). Cursor paginated. For exact identifiers prefer the by-code/by-articul/by-gtin lookups.",
        "operationId": "searchProducts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_SearchHit_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/semantic": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Semantic (natural-language) product search",
        "description": "Find products by meaning rather than keywords — describe the need in natural language ('motherboard for Ryzen 9000 with Wi-Fi 7') and get the nearest products by embedding similarity. Each hit has a score in [0,1]. Use lexical search for keyword/code lookups.",
        "operationId": "semanticSearch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SemanticSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "type": "array",
                  "title": "Response Semanticsearch"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/hybrid": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Hybrid product search (lexical + semantic, reranked)",
        "description": "Best-quality search: retrieves candidates lexically (exact tokens), semantically (embedding meaning) and — when a SPLADE model is configured — by learned-sparse terms, fuses them with Reciprocal Rank Fusion, then reorders with a cross-encoder reranker. Use this when you want the single best-ranked list and don't need pagination; each hit has a relevance score. Prefer the by-code/articul/gtin lookups for exact identifiers.",
        "operationId": "hybridSearch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HybridSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "type": "array",
                  "title": "Response Hybridsearch"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/canonical": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Hybrid search over canonical (platform) products",
        "description": "Hybrid search — lexical + semantic (+ SPLADE when configured) fused with RRF and cross-encoder reranked — over the platform's own canonical products, returning canonical product ids. Use this to resolve a need to a platform product (then fetch its offers); use /search/hybrid to search raw supplier products instead.",
        "operationId": "canonicalHybridSearch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HybridSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CanonicalHit"
                  },
                  "type": "array",
                  "title": "Response Canonicalhybridsearch"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/by-code/{code}": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Find products by supplier code",
        "description": "Exact match on a supplier's product code (or external id). Returns all matches.",
        "operationId": "searchByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Supplier product code or external id to match exactly.",
              "title": "Code"
            },
            "description": "Supplier product code or external id to match exactly."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Searchbycode"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/by-articul/{articul}": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Find products by articul",
        "description": "Exact match on a supplier's articul. Returns all matches.",
        "operationId": "searchByArticul",
        "parameters": [
          {
            "name": "articul",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Supplier articul to match exactly.",
              "title": "Articul"
            },
            "description": "Supplier articul to match exactly."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Searchbyarticul"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/by-gtin/{gtin}": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Find products by GTIN/EAN/UPC",
        "description": "Exact match on a GTIN/EAN/UPC. The value is normalized to GTIN-14 first; an invalid GTIN returns an empty list.",
        "operationId": "searchByGtin",
        "parameters": [
          {
            "name": "gtin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "GTIN/EAN/UPC (normalized to GTIN-14 before matching).",
              "title": "Gtin"
            },
            "description": "GTIN/EAN/UPC (normalized to GTIN-14 before matching)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Searchbygtin"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CanonicalHit": {
        "properties": {
          "canonical_product_id": {
            "type": "string",
            "title": "Canonical Product Id",
            "description": "Internal id (ULID) of the canonical product."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Canonical product title."
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand",
            "description": "Brand, if known."
          },
          "gtin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gtin",
            "description": "Normalized GTIN-14, if the product has one."
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score",
            "description": "Cross-encoder relevance for hybrid results (higher is better); else null."
          }
        },
        "type": "object",
        "required": [
          "canonical_product_id",
          "title"
        ],
        "title": "CanonicalHit",
        "description": "One matching canonical (platform) product. ``score`` is set for hybrid results."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HybridSearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Query text — keywords or a natural-language need. Matched by both lexical (exact tokens) and semantic (meaning) retrieval, fused, then reranked for relevance."
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "Max hits to return (1-100).",
            "default": 20
          },
          "pool": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Pool",
            "description": "Candidates retrieved per method before fusion/rerank; larger = more recall.",
            "default": 50
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "HybridSearchRequest",
        "description": "A hybrid query: lexical + semantic candidates are fused (RRF) then cross-encoder reranked."
      },
      "Page_SearchHit_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total_estimate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Estimate"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "Page[SearchHit]"
      },
      "SearchHit": {
        "properties": {
          "supplier_product_id": {
            "type": "string",
            "title": "Supplier Product Id",
            "description": "Internal id (ULID) of the matched product."
          },
          "supplier_code": {
            "type": "string",
            "title": "Supplier Code",
            "description": "Supplier the product belongs to, e.g. 'brain'."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Product name."
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand",
            "description": "Brand, if known."
          },
          "articul": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Articul",
            "description": "Supplier articul, if any."
          },
          "external_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Code",
            "description": "Supplier product code, if any."
          },
          "gtin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gtin",
            "description": "Normalized GTIN-14, if the product has one."
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score",
            "description": "Relevance score, higher is better: cosine similarity in [0,1] for semantic search, cross-encoder relevance for hybrid search; null for plain lexical hits."
          }
        },
        "type": "object",
        "required": [
          "supplier_product_id",
          "supplier_code",
          "name"
        ],
        "title": "SearchHit",
        "description": "One matching product. ``score`` is set for semantic results (cosine similarity, 0-1)."
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Free-text query, e.g. 'asus b850 wifi'. Tokenized; all tokens must match."
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor",
            "description": "Opaque cursor from a previous response's next_cursor."
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "Max hits per page (1-100).",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "description": "A lexical search query. Every token must appear in a product's name/brand/code/articul."
      },
      "SemanticSearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Natural-language need, e.g. 'motherboard for Ryzen 9000 with Wi-Fi 7'."
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "Max hits to return (1-100).",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SemanticSearchRequest",
        "description": "A natural-language search query, matched by meaning over product embeddings."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Service API key or OIDC token, issued/validated by the API gateway."
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This service (behind the API gateway)."
    }
  ],
  "tags": [
    {
      "name": "search"
    }
  ]
}
