{
  "openapi": "3.1.0",
  "info": {
    "title": "search",
    "description": "Search service. Find products by free-text query (name/brand/code/articul) or by exact identifier (code, articul, GTIN). Indexed from supplier product events.",
    "contact": {
      "name": "Supplier Aggregation Platform",
      "email": "Info_DIT@erc.ua"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Lexical product search",
        "description": "Search products by free text over name, brand, articul and codes. The query is tokenized and every token must match (AND). Cursor paginated. For exact identifiers prefer the by-code/by-articul/by-gtin lookups.",
        "operationId": "searchProducts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_SearchHit_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/by-code/{code}": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Find products by supplier code",
        "description": "Exact match on a supplier's product code (or external id). Returns all matches.",
        "operationId": "searchByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Supplier product code or external id to match exactly.",
              "title": "Code"
            },
            "description": "Supplier product code or external id to match exactly."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Searchbycode"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/by-articul/{articul}": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Find products by articul",
        "description": "Exact match on a supplier's articul. Returns all matches.",
        "operationId": "searchByArticul",
        "parameters": [
          {
            "name": "articul",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Supplier articul to match exactly.",
              "title": "Articul"
            },
            "description": "Supplier articul to match exactly."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Searchbyarticul"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/search/by-gtin/{gtin}": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Find products by GTIN/EAN/UPC",
        "description": "Exact match on a GTIN/EAN/UPC. The value is normalized to GTIN-14 first; an invalid GTIN returns an empty list.",
        "operationId": "searchByGtin",
        "parameters": [
          {
            "name": "gtin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "GTIN/EAN/UPC (normalized to GTIN-14 before matching).",
              "title": "Gtin"
            },
            "description": "GTIN/EAN/UPC (normalized to GTIN-14 before matching)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Searchbygtin"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Page_SearchHit_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total_estimate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Estimate"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "Page[SearchHit]"
      },
      "SearchHit": {
        "properties": {
          "supplier_product_id": {
            "type": "string",
            "title": "Supplier Product Id",
            "description": "Internal id (ULID) of the matched product."
          },
          "supplier_code": {
            "type": "string",
            "title": "Supplier Code",
            "description": "Supplier the product belongs to, e.g. 'brain'."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Product name."
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand",
            "description": "Brand, if known."
          },
          "articul": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Articul",
            "description": "Supplier articul, if any."
          },
          "external_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Code",
            "description": "Supplier product code, if any."
          },
          "gtin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gtin",
            "description": "Normalized GTIN-14, if the product has one."
          }
        },
        "type": "object",
        "required": [
          "supplier_product_id",
          "supplier_code",
          "name"
        ],
        "title": "SearchHit",
        "description": "One matching product."
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query",
            "description": "Free-text query, e.g. 'asus b850 wifi'. Tokenized; all tokens must match."
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor",
            "description": "Opaque cursor from a previous response's next_cursor."
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "Max hits per page (1-100).",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "description": "A lexical search query. Every token must appear in a product's name/brand/code/articul."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Service API key or OIDC token, issued/validated by the API gateway."
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This service (behind the API gateway)."
    }
  ],
  "tags": [
    {
      "name": "search"
    }
  ]
}
