{
  "openapi": "3.1.0",
  "info": {
    "title": "matching",
    "description": "Matching service. Links supplier products to canonical products (GTIN auto + operator curation) and serves the canonical catalog.",
    "contact": {
      "name": "Supplier Aggregation Platform",
      "email": "Info_DIT@erc.ua"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/canonical-products": {
      "get": {
        "tags": [
          "canonical-products"
        ],
        "summary": "List canonical products",
        "description": "List canonical (platform) products, optionally filtered by normalized GTIN-14. Cursor paginated. Use it to find the canonical product that aggregates a GTIN.",
        "operationId": "listCanonicalProducts",
        "parameters": [
          {
            "name": "gtin",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by normalized GTIN-14 (14 digits).",
              "title": "Gtin"
            },
            "description": "Filter by normalized GTIN-14 (14 digits)."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from a previous response's next_cursor.",
              "title": "Cursor"
            },
            "description": "Opaque cursor from a previous response's next_cursor."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Max items per page (1-200, default 50).",
              "default": 50,
              "title": "Limit"
            },
            "description": "Max items per page (1-200, default 50)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_CanonicalProductOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/canonical-products/{canonical_product_id}": {
      "get": {
        "tags": [
          "canonical-products"
        ],
        "summary": "Get one canonical product",
        "description": "Fetch a single canonical product by its internal canonical_product_id (ULID).",
        "operationId": "getCanonicalProduct",
        "parameters": [
          {
            "name": "canonical_product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Internal canonical_product_id (ULID).",
              "title": "Canonical Product Id"
            },
            "description": "Internal canonical_product_id (ULID)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanonicalProductOut"
                }
              }
            }
          },
          "404": {
            "description": "No canonical product with that id.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/canonical-products/{canonical_product_id}/merge": {
      "post": {
        "tags": [
          "canonical-products"
        ],
        "summary": "Merge one canonical product into another",
        "description": "Fold the source canonical into this (target) one: every supplier-product link on the source is repointed to the target, then the source is removed. Use it when two canonical products are actually the same. Emits matching.link.confirmed for each already-linked supplier product so the catalog rebuilds against the target.",
        "operationId": "mergeCanonicalProducts",
        "parameters": [
          {
            "name": "canonical_product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Target canonical id (ULID) to keep.",
              "title": "Canonical Product Id"
            },
            "description": "Target canonical id (ULID) to keep."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MergeCanonicalIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MergeResultOut"
                }
              }
            }
          },
          "404": {
            "description": "Target or source canonical does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Source and target are the same product.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/curation/queue": {
      "get": {
        "tags": [
          "curation"
        ],
        "summary": "List the matching curation queue",
        "description": "Supplier→canonical links awaiting an operator decision (status pending_review), oldest first. Cursor paginated. Confirm or reject each via the endpoints below.",
        "operationId": "listCurationQueue",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from a previous response's next_cursor.",
              "title": "Cursor"
            },
            "description": "Opaque cursor from a previous response's next_cursor."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Max items per page (1-200, default 50).",
              "default": 50,
              "title": "Limit"
            },
            "description": "Max items per page (1-200, default 50)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_CurationItemOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/curation/links/{supplier_product_id}/confirm": {
      "post": {
        "tags": [
          "curation"
        ],
        "summary": "Confirm a suggested match",
        "description": "Confirm the suggested canonical for a supplier product. Marks the link confirmed (and the canonical, if it was a draft) and emits matching.link.confirmed. Idempotent: confirming an already-confirmed link is a no-op.",
        "operationId": "confirmLink",
        "parameters": [
          {
            "name": "supplier_product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Supplier product id (ULID) to confirm.",
              "title": "Supplier Product Id"
            },
            "description": "Supplier product id (ULID) to confirm."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkDecisionOut"
                }
              }
            }
          },
          "404": {
            "description": "No such curation item.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Item already decided.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/curation/links/{supplier_product_id}/reject": {
      "post": {
        "tags": [
          "curation"
        ],
        "summary": "Reject a suggested match",
        "description": "Reject the suggested canonical for a supplier product. Idempotent: rejecting an already-rejected link is a no-op. A confirmed link cannot be rejected.",
        "operationId": "rejectLink",
        "parameters": [
          {
            "name": "supplier_product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Supplier product id (ULID) to reject.",
              "title": "Supplier Product Id"
            },
            "description": "Supplier product id (ULID) to reject."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkDecisionOut"
                }
              }
            }
          },
          "404": {
            "description": "No such curation item.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Item already decided.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/curation/links/{supplier_product_id}/create-new": {
      "post": {
        "tags": [
          "curation"
        ],
        "summary": "Create a new canonical from a curation item",
        "description": "Reject the suggested candidate and instead create a brand-new canonical product from this supplier product, linking it confirmed. Use it when the suggestion is wrong and no existing canonical fits. Emits matching.link.confirmed for the new canonical.",
        "operationId": "createNewCanonical",
        "parameters": [
          {
            "name": "supplier_product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Supplier product id (ULID).",
              "title": "Supplier Product Id"
            },
            "description": "Supplier product id (ULID)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCanonicalIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkDecisionOut"
                }
              }
            }
          },
          "404": {
            "description": "No such curation item.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Item already decided.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CanonicalProductOut": {
        "properties": {
          "canonical_product_id": {
            "type": "string",
            "title": "Canonical Product Id",
            "description": "Stable internal ULID of the canonical product."
          },
          "gtin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gtin",
            "description": "Normalized GTIN-14, if the product was matched by GTIN."
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand",
            "description": "Brand/vendor name, if known."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Canonical product title."
          }
        },
        "type": "object",
        "required": [
          "canonical_product_id",
          "title"
        ],
        "title": "CanonicalProductOut",
        "description": "A canonical (platform) product that aggregates supplier products."
      },
      "CreateCanonicalIn": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title",
            "description": "Canonical title for the new product, e.g. 'Acme Widget Pro 2000'."
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand",
            "description": "Brand/vendor name, if known."
          },
          "gtin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gtin",
            "description": "Normalized GTIN-14 to assign, if the product carries one. Must not already belong to another canonical (that would be a match, not a new product)."
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CreateCanonicalIn",
        "description": "Fields for a brand-new canonical product created from a curation item.\n\nUse this when the suggested candidate is wrong AND the supplier product is a genuinely new\nproduct (not yet in the catalog). Prefill from the supplier product; the operator may edit."
      },
      "CurationItemOut": {
        "properties": {
          "supplier_product_id": {
            "type": "string",
            "title": "Supplier Product Id",
            "description": "The supplier product to be matched (ULID)."
          },
          "canonical_product_id": {
            "type": "string",
            "title": "Canonical Product Id",
            "description": "The suggested canonical product (an existing one, or a fresh draft)."
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "How the candidate was produced (e.g. 'rag_suggested')."
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "description": "Candidate score in [0,1]; higher = stronger match."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Link status; items in the queue are 'pending_review'."
          }
        },
        "type": "object",
        "required": [
          "supplier_product_id",
          "canonical_product_id",
          "method",
          "confidence",
          "status"
        ],
        "title": "CurationItemOut",
        "description": "A supplier→canonical link awaiting an operator decision."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LinkDecisionOut": {
        "properties": {
          "supplier_product_id": {
            "type": "string",
            "title": "Supplier Product Id",
            "description": "The supplier product that was decided."
          },
          "canonical_product_id": {
            "type": "string",
            "title": "Canonical Product Id",
            "description": "The canonical product it maps to."
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "New link status: 'confirmed' or 'rejected'."
          }
        },
        "type": "object",
        "required": [
          "supplier_product_id",
          "canonical_product_id",
          "status"
        ],
        "title": "LinkDecisionOut",
        "description": "Result of confirming or rejecting a curation item."
      },
      "MergeCanonicalIn": {
        "properties": {
          "source_canonical_product_id": {
            "type": "string",
            "title": "Source Canonical Product Id",
            "description": "The canonical to merge FROM; it is removed and its links move to the target."
          }
        },
        "type": "object",
        "required": [
          "source_canonical_product_id"
        ],
        "title": "MergeCanonicalIn",
        "description": "Which canonical to fold into the target (all its links move to the target)."
      },
      "MergeResultOut": {
        "properties": {
          "target_canonical_product_id": {
            "type": "string",
            "title": "Target Canonical Product Id",
            "description": "The surviving canonical product."
          },
          "source_canonical_product_id": {
            "type": "string",
            "title": "Source Canonical Product Id",
            "description": "The merged-away canonical (now removed)."
          },
          "moved_links": {
            "type": "integer",
            "title": "Moved Links",
            "description": "How many supplier-product links were repointed."
          }
        },
        "type": "object",
        "required": [
          "target_canonical_product_id",
          "source_canonical_product_id",
          "moved_links"
        ],
        "title": "MergeResultOut",
        "description": "Outcome of merging one canonical product into another."
      },
      "Page_CanonicalProductOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CanonicalProductOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total_estimate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Estimate"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "Page[CanonicalProductOut]"
      },
      "Page_CurationItemOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CurationItemOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total_estimate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Estimate"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "Page[CurationItemOut]"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Stable URI identifying the error type."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short, human-readable summary of the error type."
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "HTTP status code."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Human/LLM-readable explanation with a next step."
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance",
            "description": "URI of the specific occurrence."
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id",
            "description": "Trace id to correlate with telemetry."
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "description": "RFC 9457 problem+json error body (returned on 4xx/5xx)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Service API key or OIDC token, issued/validated by the API gateway."
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This service (behind the API gateway)."
    }
  ],
  "tags": [
    {
      "name": "canonical-products"
    },
    {
      "name": "curation"
    }
  ]
}
