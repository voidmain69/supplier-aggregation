{
  "openapi": "3.1.0",
  "info": {
    "title": "offer",
    "description": "Offer service. Owns supplier offers (prices/availability per account), ingested from events. Query offers for a product or the cheapest offer.",
    "contact": {
      "name": "Supplier Aggregation Platform",
      "email": "Info_DIT@erc.ua"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/offers": {
      "get": {
        "tags": [
          "offers"
        ],
        "summary": "List offers for a product",
        "description": "List all supplier offers (one per account) for a product, identified by supplier_product_id. Cursor paginated. To get the cheapest, use /v1/offers/best.",
        "operationId": "listOffers",
        "parameters": [
          {
            "name": "supplier_product_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Internal product id (ULID) to list offers for.",
              "title": "Supplier Product Id"
            },
            "description": "Internal product id (ULID) to list offers for."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from a previous response's next_cursor.",
              "title": "Cursor"
            },
            "description": "Opaque cursor from a previous response's next_cursor."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Max items per page (1-200, default 50).",
              "default": 50,
              "title": "Limit"
            },
            "description": "Max items per page (1-200, default 50)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_OfferOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/offers/best": {
      "get": {
        "tags": [
          "offers"
        ],
        "summary": "Get the cheapest offer for a product",
        "description": "Return the cheapest offer for a product across all suppliers and accounts, ranked by effective UAH price (base price after each account's discount, FX and markup). 404 if the product has no offer that can yet be priced in UAH.",
        "operationId": "getBestOffer",
        "parameters": [
          {
            "name": "supplier_product_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Internal product id (ULID) to price.",
              "title": "Supplier Product Id"
            },
            "description": "Internal product id (ULID) to price."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferOut"
                }
              }
            }
          },
          "404": {
            "description": "No matching offer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/offers/{offer_id}": {
      "get": {
        "tags": [
          "offers"
        ],
        "summary": "Get one offer",
        "description": "Fetch a single offer by its internal offer_id (ULID).",
        "operationId": "getOffer",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Internal offer_id (ULID) from a list response.",
              "title": "Offer Id"
            },
            "description": "Internal offer_id (ULID) from a list response."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferOut"
                }
              }
            }
          },
          "404": {
            "description": "No matching offer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/accounts/{supplier_account_id}/terms": {
      "put": {
        "tags": [
          "offers",
          "accounts"
        ],
        "summary": "Set a supplier account's financial terms",
        "description": "Set (upsert) the financial terms for a supplier account — discount, FX rate to UAH, and platform markup — then re-price all of that account's offers. Operator/admin only (scope offer:admin); these terms are sensitive and are not exposed on read endpoints.",
        "operationId": "putAccountTerms",
        "parameters": [
          {
            "name": "supplier_account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Internal supplier account id (ULID) to set terms for.",
              "title": "Supplier Account Id"
            },
            "description": "Internal supplier account id (ULID) to set terms for."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountTermsIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountTermsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountTermsIn": {
        "properties": {
          "discount_pct": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Discount Pct",
            "description": "Negotiated discount off the base price, as a fraction (0.15 = 15%).",
            "default": "0"
          },
          "markup_pct": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Markup Pct",
            "description": "Platform markup added after discount/FX, as a fraction (0.05 = 5%).",
            "default": "0"
          },
          "fx_rate_to_uah": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fx Rate To Uah",
            "description": "Multiplier converting the account's settlement currency to UAH. Omit for UAH accounts; required to price a non-UAH account when the supplier sends no UAH price."
          }
        },
        "type": "object",
        "title": "AccountTermsIn",
        "description": "Financial terms to set for a supplier account (operator/admin input, scope-gated)."
      },
      "AccountTermsOut": {
        "properties": {
          "supplier_account_id": {
            "type": "string",
            "title": "Supplier Account Id",
            "description": "The account whose terms were set."
          },
          "discount_pct": {
            "type": "string",
            "title": "Discount Pct",
            "description": "Stored discount fraction (decimal string)."
          },
          "markup_pct": {
            "type": "string",
            "title": "Markup Pct",
            "description": "Stored markup fraction (decimal string)."
          },
          "fx_rate_to_uah": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fx Rate To Uah",
            "description": "Stored FX rate to UAH (decimal string), or null."
          },
          "offers_repriced": {
            "type": "integer",
            "title": "Offers Repriced",
            "description": "How many existing offers of this account were re-priced by this change."
          }
        },
        "type": "object",
        "required": [
          "supplier_account_id",
          "discount_pct",
          "markup_pct",
          "offers_repriced"
        ],
        "title": "AccountTermsOut",
        "description": "Confirmation that an account's terms were stored, with the count of re-priced offers."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OfferOut": {
        "properties": {
          "offer_id": {
            "type": "string",
            "title": "Offer Id",
            "description": "Stable internal ULID of this offer."
          },
          "supplier_account_id": {
            "type": "string",
            "title": "Supplier Account Id",
            "description": "Internal id of the supplier account this price belongs to."
          },
          "supplier_product_id": {
            "type": "string",
            "title": "Supplier Product Id",
            "description": "Internal id of the product this offer prices. Filter offers by it."
          },
          "price": {
            "type": "string",
            "title": "Price",
            "description": "Supplier base price, decimal string, in `currency`."
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "ISO-4217 code of `price` (the account's settlement currency)."
          },
          "price_uah": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Uah",
            "description": "Supplier's raw price converted to UAH (decimal string), or null."
          },
          "effective_price_uah": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Price Uah",
            "description": "Comparable UAH price after the account's financial terms (discount, FX, markup). This is the value offers are ranked by; null if the offer cannot yet be priced in UAH."
          },
          "rrp_uah": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rrp Uah",
            "description": "Recommended retail price in UAH, if the supplier provides it."
          },
          "observed_at": {
            "type": "string",
            "title": "Observed At",
            "description": "When the connector last observed this price (UTC)."
          }
        },
        "type": "object",
        "required": [
          "offer_id",
          "supplier_account_id",
          "supplier_product_id",
          "price",
          "currency",
          "observed_at"
        ],
        "title": "OfferOut",
        "description": "One supplier offer: a price for a product under a supplier account."
      },
      "Page_OfferOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OfferOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "total_estimate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Estimate"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "Page[OfferOut]"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Stable URI identifying the error type."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Short, human-readable summary of the error type."
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "HTTP status code."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Human/LLM-readable explanation with a next step."
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance",
            "description": "URI of the specific occurrence."
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id",
            "description": "Trace id to correlate with telemetry."
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "description": "RFC 9457 problem+json error body (returned on 4xx/5xx)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Service API key or OIDC token, issued/validated by the API gateway."
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This service (behind the API gateway)."
    }
  ],
  "tags": [
    {
      "name": "accounts"
    },
    {
      "name": "offers"
    }
  ]
}
