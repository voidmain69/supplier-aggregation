# Local dev config for the full stack. Copy to `.env` (gitignored) so `make up` picks it up:
#   cp .env.example .env && make up
# DEV ONLY — localhost, no real data. Never use these values in production.

# A demo operator principal so the curation-ui login works out of the box.
# Login token to paste into the UI: dev-operator-token
# (the key below is its SHA-256 hash; scopes cover every operator page).
API_GATEWAY_PRINCIPALS={"277e6a75a6980887d1bc5c738e59a2504e3e2696d8f9fbf675b7fc49dabd2cf8": {"subject": "operator:dev", "scopes": ["catalog:read", "offers:read", "prices:read", "matching:curate", "search:read", "sync:read"]}}

# One example scheduled account so the sync-monitoring page is not empty.
SYNC_ORCHESTRATOR_ACCOUNTS=[{"account_id": "01J0000000000000000ACCT1", "supplier_code": "brain", "settlement_currency": "USD", "interval_seconds": 3600, "mode": "delta"}]

# If host port 8080 is taken (e.g. Windows winnat reservation), publish the gateway elsewhere.
# Then start the UI dev server with VITE_API_BASE_URL=http://localhost:<port>, or rebuild the
# curation-ui image with --build-arg VITE_API_BASE_URL to match.
# API_GATEWAY_PORT=18080
