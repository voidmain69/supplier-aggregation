# Copy to .env.local for local dev. Only VITE_* vars reach the browser — never put a secret here.

# api-gateway base URL (the single ingress the UI is allowed to call).
VITE_API_BASE_URL=http://localhost:8080

# Optional Sentry/GlitchTip DSN for error monitoring. Empty disables reporting.
VITE_SENTRY_DSN=
